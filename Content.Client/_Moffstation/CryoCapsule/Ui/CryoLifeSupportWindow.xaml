<controls:FancyWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               xmlns:cryoCapsule="clr-namespace:Content.Client._Moffstation.CryoCapsule.Ui"
               MinSize="250 300"
               Resizable="True">
    <BoxContainer Orientation="Vertical">

        <BoxContainer Name="Sections"
                    Orientation="Horizontal">

            <BoxContainer Name="CryoSection"
                          VerticalExpand="True"
                          Orientation="Vertical"
                          MinWidth="250"
                          MaxWidth="250">

                <!-- Flavor text -->
                <BoxContainer Orientation="Horizontal"
                              SeparationOverride="10"
                              Margin="8 0 0 8">
                    <TextureRect StyleClasses="NTLogoDark"
                                 VerticalExpand="True"
                                 Stretch="KeepAspectCentered"
                                 SetSize="32 32"/>
                    <BoxContainer Orientation="Vertical"
                                  SeparationOverride="-4">
                        <Label Text="{Loc 'cryo-life-support-window-product-name'}"
                               StyleClasses="FontLarge"/>
                        <Label Text="{Loc 'cryo-life-support-window-product-subtitle'}"
                               StyleClasses="LabelSubText"/>
                    </BoxContainer>
                </BoxContainer>

                <PanelContainer StyleClasses="LowDivider" />

                <!-- Atmos info -->
                <cryoCapsule:GasMixControl Name="GasMixControl"/>

                <PanelContainer StyleClasses="LowDivider" />

                <!-- Reagents -->
                <cryoCapsule:SolutionInjectorControl Name="SolutionInjectorControl"/>

            </BoxContainer>

            <BoxContainer Name="PatientSection"
                          Visible="False">
                <PanelContainer StyleClasses="LowDivider" VerticalExpand="True" Margin="0 0 0 0" SetWidth="2"/>

                <!-- Patient infos -->
                <cryoCapsule:PatientHealthControl Name="PatientHealthControl"/>

            </BoxContainer>

        </BoxContainer>



    <!-- Buttons -->
        <BoxContainer Orientation="Horizontal"
                      Align="Center">
            <Button Name="RevivePatientButton" Text="Revive" StyleClasses="OpenBoth"/>
            <Button Name="EjectPatientButton" Text="Detach" StyleClasses="OpenBoth" />
        </BoxContainer>

    </BoxContainer>
</controls:FancyWindow>
